{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build FastFX Addon",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": [
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\build_addon.ps1"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/build.sh"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
